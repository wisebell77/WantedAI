# 저장소 루트(또는 그 바로 위)에 .env 로 복사해 채운다. .env 는 커밋하지 않는다.

# 공공데이터포털 — ALIO 공공기관 채용공시 (일 10,000회)
# Encoding 키를 그대로 붙여 넣어도 된다. config.api_key() 가 URL 디코딩을 한다.
DATA_GO_KR_KEY=

# 고용24 — 공채속보(210L21). 위 한도와 무관한 별개 키다.
WORK24_KEY_RECRUIT=

# 아래는 현재 추천 파이프라인에서 쓰지 않는다. 다른 API 를 붙일 때만 채운다.
# WORK24_AUTH_KEY=
# WORK24_KEY_JOBDUTY=
# WORK24_KEY_CODE=
