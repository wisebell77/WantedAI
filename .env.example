# 저장소 루트에 .env 로 복사해 채운다. .env 는 커밋하지 않는다.

# ── 앱 컨테이너 (server/local-server.mjs)

# Upstage Solar — AI 코치 · 면접 평가 · 서류심사.
# 없으면 해당 기능이 503 을 내거나 규칙 기반으로 떨어진다. 추천은 영향 없다.
UPSTAGE_API_KEY=
UPSTAGE_FAST_MODEL=solar-mini
UPSTAGE_COACH_MODEL=solar-pro4

PORT=4173
# 컨테이너에서는 0.0.0.0 을 넘겨야 외부에서 닿는다. 로컬 기본값은 127.0.0.1.
HOST=127.0.0.1

OVERLAP_DATA_DIR=data/overlap

# 추천 엔진은 별도 컨테이너다. 프론트는 결과를 지어내지 않고 503 을 표시한다.
RECOMMENDATION_BASE_URL=http://127.0.0.1:8000

# MediaPipe task 모델 위치. 컨테이너에서는 /app/models 로 구워 둔다.
MEDIAPIPE_MODEL_DIR=models
MEDIAPIPE_FPS=10

# local-server.mjs 가 Python 자식 프로세스를 띄운다(transcribe · analyze_video ·
# persona_bridge). .venv/bin/python 을 먼저 찾고 없으면 python3 로 떨어진다.
# PYTHON_BIN=/usr/local/bin/python


# ── 추천 엔진 컨테이너 (web/server.py) · 수집 파이프라인

# 엔진 자체는 키가 필요 없다. 아래는 **데이터를 수집할 때만** 쓴다.

# 공공데이터포털 — ALIO 공공기관 채용공시 (일 10,000회)
# Encoding 키를 그대로 붙여 넣어도 된다. config.api_key() 가 URL 디코딩을 한다.
DATA_GO_KR_KEY=

# 고용24 — 공채속보(210L21). 위 한도와 무관한 별개 키다.
WORK24_KEY_RECRUIT=

# 아래는 현재 파이프라인에서 쓰지 않는다. 다른 API 를 붙일 때만 채운다.
# WORK24_AUTH_KEY=
# WORK24_KEY_JOBDUTY=
# WORK24_KEY_CODE=
